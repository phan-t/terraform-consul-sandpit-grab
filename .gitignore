# ---------------------------------------------------------------- Terraform --
# Local .terraform directories
**/.terraform/*
.terraform/

# State files — may contain secrets in cleartext
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Variable files — likely to contain credentials, keys and other secrets
*.tfvars
*.tfvars.json
*.pkrvars.hcl

# Saved plans — embed resource values in cleartext, including sensitive ones
*.tfplan
*.tfplan.*
tfplan

# Crash logs
crash.log
crash.*.log

# Override files — used to override resources locally, not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json
# To version an override file, negate it, e.g.:
# !example_override.tf

# CLI configuration
.terraformrc
terraform.rc

# NOTE: .terraform.lock.hcl is deliberately NOT ignored. HashiCorp recommends
# committing the dependency lock file so provider versions are reproducible.

# ------------------------------------------------- Credentials & licences --
*.pem
*.key
*.hclic
kubeconfig*

# ------------------------------------------------------- macOS & scratch --
.DS_Store
*.tmp
